# the key of the extension used in ChurchTools
VITE_KEY=your-extension-key

# for local development provide the url and credentials
VITE_BASE_URL=https://your-instance.church.tools
VITE_USERNAME=your-username
VITE_PASSWORD=your-password

# Supabase Configuration
VITE_SUPABASE_URL=https://<your-supabase-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ChurchTools OAuth Configuration
VITE_CHURCHTOOLS_URL=https://<your-churchtools-instance>.church.tools
VITE_CHURCHTOOLS_CLIENT_ID=<your-churchtools-client-id>

# OAuth Callback URL (should match the redirect URI configured in ChurchTools)
VITE_OAUTH_CALLBACK_URL=http://localhost:5173